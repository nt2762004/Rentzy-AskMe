PROJECT_NAME="Rentzy Knowledge Base API"
DEBUG=True
API_V1_STR="/api/v1"

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rentzy_kb
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rentzy_kb

# Qdrant Configuration (Local Docker or Qdrant Cloud)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=rentzy_knowledge
QDRANT_URL=http://localhost:6333

# Redis Configuration (Session Store)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=86400

# Gemini & Embedding Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-3.1-flash-lite
EMBEDDING_MODEL_NAME=gemini-embedding-2
EMBEDDING_DIMENSION=3072

# Meta (Facebook Messenger & Instagram Direct) Configuration
META_VERIFY_TOKEN=rentzy_meta_secret_token_2026
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_API_VERSION=v19.0
